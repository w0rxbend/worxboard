# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node (site tooling)
node_modules/

# Build outputs (layout/build/layout.json is committed: it is not under /build/)
/build/
/exports/
/dist/
/_site/
/scratch/

# KiCad backups / caches / pipeline tools
*-backups/
*.kicad_prl
fp-info-cache
_autosave-*
*.lck
\#auto_saved_files#
pcb/.tools/

# Order packages: committed on main with `git add -f pcb/production` (PKG-4), so a stray build copy
# is never added by accident. New files in a package (pcbway/ ...) need the -f too.
pcb/production/*
!pcb/production/.gitkeep

# Case exports
case/exports/

# ZMK / west workspace (zephyr/module.yml at the root is tracked)
/firmware/build/
/zmk/
/modules/
/.west/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*~
