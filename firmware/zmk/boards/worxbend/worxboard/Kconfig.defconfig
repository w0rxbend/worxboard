# SPDX-License-Identifier: MIT

if BOARD_WORXBOARD_LEFT

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # BOARD_WORXBOARD_LEFT

if BOARD_WORXBOARD_LEFT || BOARD_WORXBOARD_RIGHT

# Both halves: the role-swap builds enumerate with the same name
config ZMK_KEYBOARD_NAME
    default "worxboard"

config BOARD
    default "worxboard"

config ZMK_SPLIT
    default y

# W25Q-class QSPI flash (same boot2 as the Pico); change to match the BOM part
config RP2_FLASH_W25Q080
    default y

if ZMK_DISPLAY

config LV_Z_VDB_SIZE
    default 100

config LV_DPI_DEF
    default 161

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

config LS0XX_VCOM_THREAD_PRIO
    default 11

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

config ZMK_DISPLAY_BLANK_ON_IDLE
    default n

# The custom right screen's LVGL heap, as ZMK's nice_view shield sets it: Zephyr's default
# (2048 B) is less than LVGL 9 needs for the display and the screen. The built-in screen keeps
# ZMK's own 4096 B, which is defined first and so wins.
config LV_Z_MEM_POOL_SIZE
    default 8192 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

endif # ZMK_DISPLAY

# Caps/Num/Scroll lock state is forwarded over the wired split to the right screen (§11.6)
config ZMK_HID_INDICATORS
    default y

config ZMK_SPLIT_PERIPHERAL_HID_INDICATORS
    default y

# Per-key RGB (rev B, docs/firmware.md#rgb): ZMK underglow on each half's 37-LED chain, with VLED
# switched by ext-power (worxboard.dtsi). The brightness cap (BRT_MAX) and BRT_START are set in the
# *_defconfig files: ZMK's Kconfig.defaults is read before this file, so defaults here would lose.
config ZMK_RGB_UNDERGLOW
    default y

if ZMK_RGB_UNDERGLOW

endif # ZMK_RGB_UNDERGLOW

# The host port feeds both halves' LEDs (docs/firmware.md#rgb): declare 500 mA, bus powered. Zephyr's
# defaults (100 mA, self powered) let a host that budgets by descriptor refuse or starve the board
config USB_MAX_POWER
    default 250 if USB_DEVICE_STACK

config USB_SELF_POWERED
    default n if USB_DEVICE_STACK

if ZMK_RGB_UNDERGLOW

# ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE stays at ZMK's default (n): idle-off saves "off", so the board would
# boot dark after any idle spell (docs/firmware.md#split-behaviour). The LED load is inside the budget
# at the BRT_MAX cap; RGB_TOG switches the strip and VLED off.

# Only Studio (left) and BLE enable settings in ZMK. Without them the wired right half would forget
# its RGB state and boot lit at BRT_START whatever the left restored.
config SETTINGS
    default y

endif # ZMK_RGB_UNDERGLOW

endif # BOARD_WORXBOARD_LEFT || BOARD_WORXBOARD_RIGHT

if BOARD_WORXBOARD_RIGHT

# Right half: custom LVGL screen (firmware/zmk/src/worx_status_screen.c)
choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

endif # BOARD_WORXBOARD_RIGHT
