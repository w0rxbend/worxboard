/* SPDX-License-Identifier: MIT */
/dts-v1/;

#include <raspberrypi/rpi_pico/rp2350a.dtsi>
#include <raspberrypi/rpi_pico/m33.dtsi>
#include <arm/raspberrypi/rp2350-boot-mode-retention.dtsi>
#include <freq.h>
#include <zephyr/dt-bindings/led/led.h>

#include "worxboard-pinctrl.dtsi"
#include "../worxboard/worxboard-layouts.dtsi"   /* shared, generated */

/ {
    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,flash-controller = &qmi;
        zephyr,code-partition = &code_partition;
        zmk,kscan = &kscan0;
        zmk,physical-layout = &worxboard_layout;
        zephyr,display = &nice_view;
        zmk,underglow = &led_strip;
    };

    /* Matrix 6 x 7 col2row (design.md §3/§5). COLn = physical column Cn, C0 outer, on both
     * PCBs; the right .dts reverses col-gpios so its logical order runs inner -> outer. */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&gpio0 14 GPIO_ACTIVE_HIGH>
            , <&gpio0 15 GPIO_ACTIVE_HIGH>
            , <&gpio0 16 GPIO_ACTIVE_HIGH>
            , <&gpio0 17 GPIO_ACTIVE_HIGH>
            , <&gpio0 18 GPIO_ACTIVE_HIGH>
            , <&gpio0 19 GPIO_ACTIVE_HIGH>
            , <&gpio0 20 GPIO_ACTIVE_HIGH>
            ;
    };

    wired_split {
        compatible = "zmk,wired-split";
        device = <&uart0>;
    };

    /* VLED: GP23 = RGB_EN drives U6 SY6280AAC EN (VSYS -> VLED, active high, 10k pull-down).
     * ZMK turns it on at boot and off with the underglow (CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER). */
    vled: vled {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
    };
};

&flash0 {
    reg = <0x10000000 DT_SIZE_M(4)>;

    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        image_def: partition@0 {
            reg = <0x00000000 0x100>;
            read-only;
        };

        code_partition: partition@100 {
            reg = <0x100 (DT_SIZE_M(4) - 0x100 - DT_SIZE_K(512))>;
            read-only;
        };

        storage_partition: partition@380000 {
            reg = <0x380000 DT_SIZE_K(512)>;
        };
    };
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-names = "default";
};

/* Per-key RGB (rev B): one chain of 37 SK6812MINI-E per half, LED101 = layout/leds.py CHAIN[0].
 * PIO0 belongs to the strip alone: the driver loads its 4-instruction program with origin -1 and
 * starts the state machine at instruction 31, which is its own only in an otherwise empty PIO. */
&pio0 {
    status = "okay";

    pio0_ws2812: pio0_ws2812 {
        compatible = "worldsemi,ws2812-rpi_pico-pio";
        status = "okay";
        pinctrl-0 = <&pio0_ws2812_default>;
        pinctrl-names = "default";
        /* 10 PIO cycles per bit at 800 kHz: T0H 375 ns, T1H 750 ns (as Zephyr's RP2040 boards) */
        bit-waveform = <3>, <3>, <4>;

        led_strip: ws2812 {
            status = "okay";
            gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;  /* pin number only; the mux is pinctrl-0 */
            chain-length = <37>;
            color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
            reset-delay = <500>;                   /* us; > 200 us low between frames: the driver starts this
                                                      sleep when the last word is queued, up to ~270 us before it is sent */
            frequency = <800000>;
        };
    };
};

&pio1 {
    status = "okay";

    nice_view_spi: nice_view_spi {
        compatible = "raspberrypi,pico-spi-pio";
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;
        clocks = <&clocks RPI_PICO_CLKID_CLK_SYS>;
        clock-frequency = <DT_FREQ_M(1)>;
        pinctrl-0 = <&pio1_spi_default>;
        pinctrl-names = "default";
        clk-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
        mosi-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
        /* The driver claims miso-gpios for PIO1 in 4-wire mode even when unset (pin 0 =
         * UART0 TX). Reusing MOSI keeps it off the split link (deviations REVIEW-FIX-1). */
        miso-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
        cs-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;

        nice_view: ls0xx@0 {
            compatible = "sharp,ls0xx";
            reg = <0>;
            spi-max-frequency = <DT_FREQ_M(1)>;
            width = <160>;
            height = <68>;
            serial-vcom-inversion;
            serial-vcom-interval = <33>;
        };
    };
};

&timer0 {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

zephyr_udc0: &usbd {
    status = "okay";
};
