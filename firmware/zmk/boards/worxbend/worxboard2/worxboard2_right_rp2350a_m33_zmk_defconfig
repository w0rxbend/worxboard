CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=150000000
CONFIG_RESET=y
CONFIG_CLOCK_CONTROL=y
CONFIG_GPIO=y
CONFIG_PINCTRL=y
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_BUILD_OUTPUT_HEX=y

# Settings (ZMK Studio / keymap persistence)
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# &bootloader / double-tap reset
CONFIG_RETAINED_MEM=y
CONFIG_RETENTION=y
CONFIG_RETENTION_BOOT_MODE=y

# Per-key RGB power cap (docs/firmware.md#rgb). ZMK scales brightness 0-100 onto BRT_MIN-BRT_MAX %.
# Full white at 8 %: 37 x 36 mA x 8 % ~ 107 mA per half (129 mA at the datasheet's 14.5 mA per colour),
# plus 22 mA of dark LEDs and ~30 mA of RP2040, flash and display: <= ~181 mA: under 40 % of the 500 mA hold
# of the cable polyfuses F1 that feed the right half, ~360 mA of the left port's 500 mA for both halves. Raise it only in
# split-power mode (JP1 cut on both halves, a USB-C cable on each half), and to 20 at most (U6's limit).
CONFIG_ZMK_RGB_UNDERGLOW_BRT_MIN=1
CONFIG_ZMK_RGB_UNDERGLOW_BRT_MAX=8
# ZMK limits BRT_START to BRT_MAX on the 0-100 scale: 8 -> 1 + 7 x 8 / 100 = 1 % at boot (BRT_MIN keeps it lit)
CONFIG_ZMK_RGB_UNDERGLOW_BRT_START=8

# ZMK_CONFIG has no worxboard2.conf: enable the user options of config/worxboard.conf here
CONFIG_ZMK_DISPLAY=y
CONFIG_ZMK_POINTING=y
