/*
 * worxboard keymap: 74 keys, 3 layers, after the QMK ergodox_ez default (design.md §5, §11.3).
 * Binding order = transform order = physical-layout order (worxboard-layouts.dtsi):
 *   rows 0..4: 12 / 14 / 12 / 14 / 10 keys, left outer -> inner, then right inner -> outer;
 *   thumbs:    (5,5) (5,6) (5,7) (5,8) / (5,4) (5,9) / (5,1) (5,2) (5,3) (5,10) (5,11) (5,12).
 * The inner-top keys of the EZ are the displays; their LEFT / RGHT move to layer 1.
 * Check with `just fw-keymap-check` (74 bindings per layer, base layer = layout.json legends).
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYMB 1
#define MDIA 2

#define HYPER LC(LS(LA(LGUI)))
#define MEH   LC(LS(LALT))

/ {
    behaviors {
        /* QMK TT(): hold = momentary layer, tap = toggle layer */
        tt: tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp EQUAL    &kp N1      &kp N2         &kp N3   &kp N4    &kp N5                         &kp N6   &kp N7   &kp N8    &kp N9  &kp N0          &kp MINUS
&kp DEL      &kp Q       &kp W          &kp E    &kp R     &kp T   &tog SYMB    &tog SYMB &kp Y    &kp U    &kp I     &kp O   &kp P           &kp BSLH
&kp BSPC     &kp A       &kp S          &kp D    &kp F     &kp G                          &kp H    &kp J    &kp K     &kp L   &lt MDIA SEMI   &mt LGUI SQT
&kp LSHFT    &mt LCTRL Z &kp X          &kp C    &kp V     &kp B   &kp HYPER    &kp MEH   &kp N    &kp M    &kp COMMA &kp DOT &mt LCTRL FSLH  &kp RSHFT
&lt SYMB GRAVE &kp SQT   &kp LA(LSHFT)  &kp LEFT &kp RIGHT                                         &kp UP   &kp DOWN  &kp LBKT &kp RBKT      &tt SYMB SYMB
                                        &mt LALT K_APP &kp LGUI           &kp LALT &mt LCTRL ESC
                                                       &kp HOME           &kp PG_UP
                               &kp SPACE &kp BSPC      &kp END            &kp PG_DN &kp TAB &kp RET
            >;
        };

        symb {
            display-name = "Sym";
            bindings = <
&trans       &kp F1      &kp F2         &kp F3   &kp F4    &kp F5                         &kp F6   &kp F7   &kp F8    &kp F9  &kp F10         &kp F11
&trans       &kp EXCL    &kp AT         &kp LBRC &kp RBRC  &kp PIPE &trans      &trans    &kp UP   &kp N7   &kp N8    &kp N9  &kp ASTRK       &kp F12
&trans       &kp HASH    &kp DLLR       &kp LPAR &kp RPAR  &kp GRAVE                      &kp DOWN &kp N4   &kp N5    &kp N6  &kp PLUS        &trans
&trans       &kp PRCNT   &kp CARET      &kp LBKT &kp RBKT  &kp TILDE &kp LEFT   &kp RIGHT &kp AMPS &kp N1   &kp N2    &kp N3  &kp BSLH        &trans
&trans       &trans      &trans         &trans   &trans                                            &trans   &kp DOT   &kp N0  &kp EQUAL       &trans
                                        &trans   &trans                           &trans   &trans
                                                 &trans                           &trans
                               &trans   &trans   &trans                           &trans   &trans  &trans
            >;
        };

        mdia {
            display-name = "Media";
            bindings = <
&bootloader  &sys_reset  &trans         &trans   &trans    &trans                         &trans   &trans   &trans    &trans  &sys_reset      &bootloader
&trans       &trans      &trans         &mmv MOVE_UP &trans &trans &trans       &trans    &trans   &trans   &trans    &trans  &trans          &trans
&trans       &trans      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans                 &trans   &trans   &trans    &trans  &trans          &kp C_PP
&trans       &trans      &trans         &trans   &trans    &trans  &trans       &trans    &trans   &trans   &kp C_PREV &kp C_NEXT &trans      &trans
&studio_unlock &trans    &trans         &mkp LCLK &mkp RCLK                                        &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE &trans &trans
                                        &trans   &trans                           &trans   &trans
                                                 &trans                           &trans
                               &trans   &trans   &trans                           &trans   &trans  &kp C_AC_BACK
            >;
        };
    };
};
